#the mod name as displayed in-game
displayName: "Turret Auto Fill"

#the internal name of the mod
name: "turret-auto-fill"

#author
author: "Vini230909"

#github repository, used for in-game update checks and reinstalls
repo: "Vini230909/Turretautofill"

#the fully qualified main class of the mod
main: "vini.turretautofill.TurretAutoFill"

#the mod description as seen in the mod dialog
description: "Automatically fills nearby item turrets with the best ammo from your carried items or the closest core. Toggle with F4; configure ammo priorities in Settings > Turret Auto Fill."

#the mod version
version: 0.6.0

#the minimum game build required to run this mod
minGameVersion: 154

#client-side only: not required on servers, so you can join any server with this installed
hidden: true

#this is a java mod
java: true
